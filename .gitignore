@'
# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python virtual environments
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/

# Python cache
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Database files
*.db
*.sqlite
*.sqlite3

# Node.js dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build outputs
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo/

# IDE files
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
*.swp
*.bak

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
'@ | Set-Content -Path .gitignore -Encoding utf8